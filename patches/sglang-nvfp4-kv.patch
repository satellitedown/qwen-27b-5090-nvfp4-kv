+++ b/sglang/kernels/ops/kvcache/nvfp4_dequant.py
@@ -0,0 +1,104 @@
+# Modified for qwen-27b-5090-nvfp4-kv: native causal verification and fused prefill KV conversion.
+# Modifications Copyright 2026 satellitedown. SPDX-License-Identifier: Apache-2.0
+"""Gather NVFP4 cache rows directly into the shared FP8 prefill workspace."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _decode_e2m1(packed, column):
+    bits = (packed >> ((column & 1) * 4)) & 15
+    exponent = (bits >> 1) & 3
+    mantissa = (bits & 1).to(tl.float32)
+    power = ((exponent.to(tl.uint32) + 126) << 23).to(tl.float32, bitcast=True)
+    magnitude = tl.where(exponent == 0, mantissa * 0.5, (1.0 + mantissa * 0.5) * power)
+    signed_bits = magnitude.to(tl.uint32, bitcast=True) | (
+        (bits & 8).to(tl.uint32) << 28
+    )
+    return signed_bits.to(tl.float32, bitcast=True)
+
+
+@triton.jit
+def _to_workspace_dtype(value, DTYPE: tl.constexpr):
+    # Match FlashInfer's BF16 dequantization followed by torch's FP8 cast,
+    # including this runtime's saturating FP8 cast, without materializing BF16.
+    rounded = value.to(tl.bfloat16).to(tl.float32)
+    return rounded.to(DTYPE)
+
+
+@triton.jit
+def _gather_nvfp4_to_fp8(
+    K,
+    V,
+    KS,
+    VS,
+    KG,
+    VG,
+    INDICES,
+    OUT_K,
+    OUT_V,
+    N,
+    WIDTH: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    offset = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    row = offset // WIDTH
+    col = offset % WIDTH
+    valid = row < N
+    source = tl.load(INDICES + row, mask=valid, other=0).to(tl.int64)
+    packed_offset = source * (WIDTH // 2) + col // 2
+    scale_offset = source * (WIDTH // 16) + col // 16
+    kp = tl.load(K + packed_offset, mask=valid, other=0)
+    ks = tl.load(KS + scale_offset, mask=valid, other=0.0).to(tl.float32)
+    kval = (_decode_e2m1(kp, col) * ks) * tl.load(KG)
+    tl.store(
+        OUT_K + offset, _to_workspace_dtype(kval, OUT_K.dtype.element_ty), mask=valid
+    )
+    vp = tl.load(V + packed_offset, mask=valid, other=0)
+    vs = tl.load(VS + scale_offset, mask=valid, other=0.0).to(tl.float32)
+    vval = (_decode_e2m1(vp, col) * vs) * tl.load(VG)
+    tl.store(
+        OUT_V + offset, _to_workspace_dtype(vval, OUT_V.dtype.element_ty), mask=valid
+    )
+
+
+def gather_nvfp4_to_fp8(
+    k: torch.Tensor,
+    v: torch.Tensor,
+    k_scales: torch.Tensor,
+    v_scales: torch.Tensor,
+    k_global_scale: torch.Tensor,
+    v_global_scale: torch.Tensor,
+    indices: torch.Tensor,
+    out_k: torch.Tensor,
+    out_v: torch.Tensor,
+) -> None:
+    """Gather arbitrary cache slots, preserving BF16->FP8 rounding in-place."""
+    assert k.shape == v.shape and out_k.shape == out_v.shape
+    assert out_k.dtype == out_v.dtype == torch.float8_e4m3fn
+    assert out_k.shape == (indices.numel(), k.shape[1], k.shape[2] * 2)
+    assert all(
+        t.is_contiguous() for t in (k, v, k_scales, v_scales, indices, out_k, out_v)
+    )
+    n = indices.numel()
+    if n == 0:
+        return
+    width = k.shape[1] * k.shape[2] * 2
+    _gather_nvfp4_to_fp8[(triton.cdiv(n * width, 4096),)](
+        k,
+        v,
+        k_scales.view(torch.float8_e4m3fn),
+        v_scales.view(torch.float8_e4m3fn),
+        k_global_scale,
+        v_global_scale,
+        indices,
+        out_k,
+        out_v,
+        n,
+        WIDTH=width,
+        BLOCK=4096,
+        num_warps=8,
+        enable_fp_fusion=False,
+    )
