        "first_stream_token_count": 1,
        "output": "```python\nimport time\nfrom collections import OrderedDict\n\n\nclass LRUCache:\n    \"\"\"\n    A bounded LRU cache with TTL (Time-To-Live) support.\n    \n    - Capacity: maximum number of entries.\n    - TTL: time-to-live in seconds for each entry.\n    - clock: a callable that returns the current monotonic time.\n    \n    Expiry is inclusive: an entry is considered expired if now >= deadline.\n    Successful get() makes the entry most recent.\n    Replacing a key refreshes its TTL.\n    Expired entries are cleaned up lazily and do not evict live entries.\n    \"\"\"\n\n    def __init__(self, capacity, ttl, clock=None):\n        if capacity <= 0:\n            raise ValueError(\"capacity must be positive\")\n        if ttl <= 0:\n            raise ValueError(\"ttl must be positive\")\n        if clock is None:\n            clock = time.monotonic\n        self.capacity = capacity\n        self.ttl = ttl\n        self.clock = clock\n        # OrderedDict: key -> (value, deadline)\n        self._data = OrderedDict()\n\n    def _now(self):\n        return self.clock()\n\n    def _is_expired(self, deadline, now=None):\n        if now is None:\n            now = self._now()\n        return now >= deadline\n\n    def get(self, key, default=None):\n        now = self._now()\n        if key in self._data:\n            value, deadline = self._data[key]\n            if self._is_expired(deadline, now):\n                # Remove expired entry\n                del self._data[key]\n                return default\n            # Move to most recent\n            self._data.move_to_end(key)\n            return value\n        return default\n\n    def put(self, key, value):\n        now = self._now()\n        deadline = now + self.ttl\n        if key in self._data:\n            # Update value and refresh TTL\n            self._data[key] = (value, deadline)\n            self._data.move_to_end(key)\n        else:\n            self._data[key] = (value, deadline)\n            # If over capacity, evict least recent (and clean up expired first)\n            if len(self._data) > self.capacity:\n                self._evict_lru()\n\n    def _evict_lru(self):\n        # Remove expired entries first (they don't count against capacity for eviction purposes)\n        now = self._now()\n        expired_keys = [k for k, (v, deadline) in self._data.items() if self._is_expired(deadline, now)]\n        for k in expired_keys:\n            del self._data[k]\n        # If still over capacity, evict LRU\n        while len(self._data) > self.capacity:\n            self._data.popitem(last=False)\n\n    def __len__(self):\n        # Clean up expired entries before returning length\n        now = self._now()\n        expired_keys = [k for k, (v, deadline) in self._data.items() if self._is_expired(deadline, now)]\n        for k in expired_keys:\n            del self._data[k]\n        return len(self._data)\n\n    def __contains__(self, key):\n        now = self._now()\n        if key in self._data:\n            value, deadline = self._data[key]\n            if self._is_expired(deadline, now):\n                del self._data[key]\n                return False\n            return True\n        return False\n```",
