  "checker_source": "import sys,json,resource\nresource.setrlimit(resource.RLIMIT_CPU,(3,3))\nresource.setrlimit(resource.RLIMIT_AS,(512*1024*1024,512*1024*1024))\npayload=json.load(sys.stdin)\nns={\"__name__\":\"generated\"}\nexec(compile(payload[\"code\"],\"<generated>\",\"exec\"),ns)\nCache=ns[\"LRUCache\"]\nresults={}\ndef check(name, fn):\n    try:\n        fn()\n        results[name]=\"pass\"\n    except Exception as e:\n        results[name]=type(e).__name__+\": \"+str(e)\ndef expiry():\n    now=[0.0]; c=Cache(2,5,lambda:now[0]); c.put(\"a\",1); now[0]=4.999\n    assert c.get(\"a\")==1\n    now[0]=5; assert c.get(\"a\",\"missing\")==\"missing\"; assert len(c)==0\ndef lru():\n    c=Cache(2,10,lambda:0); c.put(\"a\",1); c.put(\"b\",2); assert c.get(\"a\")==1\n    c.put(\"c\",3); assert c.get(\"b\")==None; assert c.get(\"a\")==1; assert c.get(\"c\")==3; assert len(c)==2\ndef overwrite():\n    now=[0]; c=Cache(2,5,lambda:now[0]); c.put(\"a\",1); now[0]=4; c.put(\"a\",2)\n    now[0]=5; assert c.get(\"a\")==2; assert len(c)==1\n    now[0]=9; assert c.get(\"a\")==None; assert len(c)==0\ndef cleanup():\n    now=[0]; c=Cache(2,5,lambda:now[0]); c.put(\"a\",1); now[0]=3; c.put(\"b\",2); c.get(\"a\")\n    now[0]=5; c.put(\"c\",3); assert c.get(\"b\")==2; assert c.get(\"c\")==3; assert c.get(\"a\")==None; assert len(c)==2\ndef invalid():\n    for capacity,ttl in [(0,1),(-1,1),(1,0),(1,-1)]:\n        try: Cache(capacity,ttl,lambda:0)\n        except ValueError: continue\n        raise AssertionError((capacity,ttl))\nfor name,fn in [(\"expiry_boundary\",expiry),(\"lru_eviction\",lru),(\"overwrite_refresh\",overwrite),(\"expired_mru_cleanup\",cleanup),(\"invalid_arguments\",invalid)]:check(name,fn)\nprint(json.dumps(results))\n",
  "interpretation": "One deterministic LRU/TTL coding task, five independent behavior checks. The paired FP8 comparison covers only 8192/32768/122000 inputs. Backend and KV dtype both change. Syntax failures with finish_reason=length are incomplete generations at the output cap, not isolated KV-quality evidence."
